# Clarity B2B - server environment.
# Copy this file to  .env  and fill in your own values.
# .env is ignored by git, so secrets never get pushed to GitHub.
#
# Everything points at ONE Supabase project. Two connection styles are used:
#   - DATABASE_URL is the raw PostgreSQL string, used by the pg pool
#     (invoices + payouts, Apurba's code).
#   - SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are used by the Supabase client
#     (invoice status pipeline, Mihir's code).

# --- Raw PostgreSQL (pg) ---------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> Session pooler
# The host should contain "pooler.supabase.com".
# Replace [YOUR-PASSWORD] with your real database password.
DATABASE_URL=postgresql://postgres.eccnwrodjktfamizdzeb:digonto12345%24@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

NEXT_PUBLIC_SUPABASE_URL=https://eccnwrodjktfamizdzeb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVjY253cm9kamt0ZmFtaXpkemViIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYxMjAzMTAsImV4cCI6MjEwMTY5NjMxMH0.FT1SwfcMpZCQ67WQG5XJeMa2F6vs85vDpBooJaHhays
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVjY253cm9kamt0ZmFtaXpkemViIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NjEyMDMxMCwiZXhwIjoyMTAxNjk2MzEwfQ.7XNRCdphqAO0VgNrS_zU7uQsNB1EV6B9xmr05Xh9OX0
