# --- Login/signup (feature/auth branch) -------------------------------------
# Any long random string works locally. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Funder Deposit & Invoice Funding (Apurba, M3) --------------------------
