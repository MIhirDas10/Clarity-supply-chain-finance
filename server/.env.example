# Clarity B2B - server environment.
# Copy this file to  .env  and fill in your own values.
# .env is ignored by git, so secrets never get pushed to GitHub.
#
# Everything points at ONE Supabase project. Two connection styles are used:
#   - DATABASE_URL is the raw PostgreSQL string, used by the pg pool
#     (invoices + payouts, Apurba's code).
#   - SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are used by the Supabase client
#     (invoice status pipeline, Mihir's code).

# --- Raw PostgreSQL (pg) ---------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> Session pooler
# The host should contain "pooler.supabase.com".
# Replace [YOUR-PASSWORD] with your real database password.
DATABASE_URL=postgresql://postgres.eccnwrodjktfamizdzeb:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

NEXT_PUBLIC_SUPABASE_URL=https://eccnwrodjktfamizdzeb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key-from-supabase-project-settings
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key-from-supabase-project-settings
PORT=5001

# --- Cloudinary (Apurba - invoice document storage) ------------------------
# Cloudinary dashboard -> API Keys. One URL holds cloud name, key and secret.
CLOUDINARY_URL=cloudinary://replace-with-your-api-key:replace-with-your-api-secret@replace-with-your-cloud-name

# --- Auth (Common Workflow - Login, Signup & Admin Approval) ---------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Google Calendar OAuth (Ameet, M4) --------------------------------------
# Create a Web OAuth client in Google Cloud Console and add this callback URL
# to its authorised redirect URIs.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Optional separate OAuth client for Ameet's Google Calendar sync.
# If omitted, Calendar falls back to the shared Google client above.
GOOGLE_CALENDAR_CLIENT_ID=replace-with-google-calendar-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-google-calendar-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/calendar/oauth/callback

# Optional separate OAuth client for Mihir's ERP / Google Sheets sync.
# If omitted, ERP falls back to the shared Google client above.
GOOGLE_CLIENT_ID_ERP=replace-with-google-sheets-oauth-client-id
GOOGLE_CLIENT_SECRET_ERP=replace-with-google-sheets-oauth-client-secret
GOOGLE_REDIRECT_URI_ERP=http://localhost:5001/api/erp/oauth/callback
APP_URL=http://localhost:5173

# --- Email Notifications ----------------------------------------------------
# Gmail app password recommended; keep the real value only in server/.env.
EMAIL_USER=replace-with-sender-email
EMAIL_PASS=replace-with-gmail-app-password

# --- Funder Deposit & Invoice Funding (Apurba, M3) --------------------------
# bKash Tokenized Checkout sandbox credentials, issued by bKash's own
# developer portal (developer.bka.sh) for sandbox registration - safe to
# share, not a real merchant account. Register your own for production.
BKASH_GRANT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/token/grant
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
