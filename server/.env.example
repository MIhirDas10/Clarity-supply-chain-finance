# Copy this file to  .env  and paste in your own connection string.
# .env is ignored by git, so the password is never pushed to GitHub.
#
# Supabase: Project Settings -> Database -> Connection string -> Session pooler
# The host should contain "pooler.supabase.com".
# Remember to replace [YOUR-PASSWORD] with your real database password.

DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
