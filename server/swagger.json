{
  "openapi": "3.0.0",
  "info": {
    "title": "Clarity B2B API",
    "version": "1.0.0",
    "description": "API documentation for the Clarity Supply Chain Finance backend. This covers the Invoice Pipeline and Supplier Health Analytics modules."
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "Pipeline", "description": "Invoice Status Pipeline operations" },
    { "name": "Health", "description": "Supplier Health & Distress Analytics operations" },
    { "name": "ERP", "description": "Buyer accounts-payable ledger and Google Sheets sync" }
  ],
  "paths": {
    "/api/pipeline/invoices": {
      "get": {
        "tags": ["Pipeline"],
        "summary": "Get all invoices",
        "description": "Fetches a list of all invoices and their status history.",
        "responses": {
          "200": {
            "description": "A JSON array of invoices"
          }
        }
      },
      "post": {
        "tags": ["Pipeline"],
        "summary": "Create a new invoice",
        "description": "Creates a new invoice record in the system pipeline.",
        "responses": {
          "201": {
            "description": "Invoice created successfully"
          }
        }
      }
    },
    "/api/pipeline/invoices/{id}/status": {
      "get": {
        "tags": ["Pipeline"],
        "summary": "Get invoice status",
        "description": "Get the current pipeline status for a specific invoice.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "patch": {
        "tags": ["Pipeline"],
        "summary": "Update invoice status",
        "description": "Move the invoice forward in the pipeline and recalculate supplier health.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newStatus": {
                    "type": "string",
                    "example": "Funded"
                  },
                  "actorName": {
                    "type": "string",
                    "example": "Admin"
                  },
                  "supplierPhone": {
                    "type": "string",
                    "example": "+8801711223344"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice updated successfully"
          }
        }
      }
    },
    "/api/health/suppliers": {
      "get": {
        "tags": ["Health"],
        "summary": "List all suppliers' health",
        "description": "Returns every supplier with their computed health score and band.",
        "parameters": [
          {
            "name": "buyer",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Optional buyer name to filter suppliers."
          }
        ],
        "responses": {
          "200": { "description": "JSON array of supplier analytics" }
        }
      }
    },
    "/api/health/suppliers/{id}": {
      "get": {
        "tags": ["Health"],
        "summary": "Get specific supplier's health",
        "description": "Returns full health detail (signals, reasons, band) for a specific supplier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Supplier health details" },
          "404": { "description": "Supplier not found" }
        }
      }
    },
    "/api/health/suppliers/{id}/watchlist": {
      "post": {
        "tags": ["Health"],
        "summary": "Toggle supplier on watchlist",
        "description": "Adds or removes a supplier from the buyer's review watchlist.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Successfully toggled watchlist status" }
        }
      }
    },
    "/api/health/summary": {
      "get": {
        "tags": ["Health"],
        "summary": "Get health summary",
        "description": "Returns counts and percentages of suppliers in each band.",
        "responses": {
          "200": { "description": "JSON object with summary statistics" }
        }
      }
    },
    "/api/health/recalculate": {
      "post": {
        "tags": ["Health"],
        "summary": "Recalculate all health scores",
        "description": "Force a recalculation of all supplier health scores, potentially triggering distress alerts.",
        "responses": {
          "200": { "description": "Recalculation successful" }
        }
      }
    },
    "/api/health/alerts": {
      "get": {
        "tags": ["Health"],
        "summary": "Get distress alerts",
        "description": "Lists all distress alerts, newest first.",
        "responses": {
          "200": { "description": "JSON array of alerts" }
        }
      }
    },
    "/api/health/alerts/{id}/acknowledge": {
      "patch": {
        "tags": ["Health"],
        "summary": "Acknowledge alert",
        "description": "Marks a specific alert as read (seen by the buyer).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Alert acknowledged" },
          "404": { "description": "Alert not found" }
        }
      }
    },
    "/api/health/watchlist": {
      "get": {
        "tags": ["Health"],
        "summary": "Get watchlisted suppliers",
        "description": "Returns only the suppliers currently on the buyer's watchlist.",
        "responses": {
          "200": { "description": "JSON array of watchlisted suppliers" }
        }
      }
    },
    "/api/health/config": {
      "get": {
        "tags": ["Health"],
        "summary": "Get health scoring configuration",
        "description": "Show the current band thresholds.",
        "responses": {
          "200": { "description": "JSON object containing watchBelow and distressBelow" }
        }
      },
      "patch": {
        "tags": ["Health"],
        "summary": "Update health scoring configuration",
        "description": "Update the band thresholds for Watch and Distress.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "watchBelow": { "type": "number", "example": 80 },
                  "distressBelow": { "type": "number", "example": 60 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Configuration updated successfully" },
          "400": { "description": "Invalid thresholds" }
        }
      }
    },
    "/api/confirmations/pending": {
      "get": {
        "summary": "Get pending confirmations",
        "description": "Get a list of invoices that require buyer confirmation.",
        "parameters": [
          {
            "name": "buyer",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Name of the buyer"
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON array of pending invoices"
          }
        }
      }
    },
    "/api/confirmations/history": {
      "get": {
        "summary": "Get confirmation history",
        "description": "Get a list of invoices that have already been confirmed or disputed by the buyer.",
        "parameters": [
          {
            "name": "buyer",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Name of the buyer"
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON array of processed invoices"
          }
        }
      }
    },
    "/api/confirmations/{id}/confirm": {
      "post": {
        "summary": "Confirm an invoice",
        "description": "Confirm an invoice as a buyer, moving it to 'Buyer Confirmed' status.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "buyer_name": {
                    "type": "string"
                  },
                  "acknowledgment_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice confirmed successfully"
          },
          "404": {
            "description": "Invoice not found or unauthorized"
          }
        }
      }
    },
    "/api/disputes": {
      "get": {
        "summary": "Get all disputes",
        "description": "Get a list of all filed disputes.",
        "responses": {
          "200": {
            "description": "A JSON array of disputes"
          }
        }
      },
      "post": {
        "summary": "File a new dispute",
        "description": "File a dispute against an invoice, freezing it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "invoice_id": {
                    "type": "string"
                  },
                  "filed_by": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dispute filed successfully"
          }
        }
      }
    },
    "/api/disputes/{id}": {
      "get": {
        "summary": "Get dispute details",
        "description": "Get the details of a specific dispute.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dispute details"
          },
          "404": {
            "description": "Dispute not found"
          }
        }
      }
    },
    "/api/disputes/{id}/evidence": {
      "post": {
        "summary": "Add evidence to a dispute",
        "description": "Upload a document link to support an open dispute.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "uploaded_by": {
                    "type": "string"
                  },
                  "file_url": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence added successfully"
          },
          "404": {
            "description": "Dispute not found"
          }
        }
      }
    },
    "/api/disputes/{id}/resolve": {
      "patch": {
        "summary": "Resolve a dispute",
        "description": "Release the invoice back to the marketplace or void it entirely.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": ["released", "voided"]
                  },
                  "actor": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dispute resolved successfully"
          },
          "404": {
            "description": "Dispute not found"
          }
        }
      }
    },
    "/api/erp/status": {
      "get": {
        "tags": ["ERP"],
        "summary": "Get ERP status",
        "description": "Returns connection state, AP summary, aging buckets, and sync health.",
        "responses": { "200": { "description": "ERP status returned" } }
      }
    },
    "/api/erp/ledger": {
      "get": {
        "tags": ["ERP"],
        "summary": "List AP ledger rows",
        "description": "Returns platform-synced and manual accounts-payable rows for the buyer.",
        "responses": { "200": { "description": "Ledger rows returned" } }
      },
      "post": {
        "tags": ["ERP"],
        "summary": "Create manual payable",
        "description": "Adds an off-platform bill to the buyer's AP ledger.",
        "responses": { "201": { "description": "Manual payable created" } }
      }
    },
    "/api/erp/ledger/{invoiceId}": {
      "patch": {
        "tags": ["ERP"],
        "summary": "Update a ledger row",
        "description": "Updates a manual payable or accounting metadata on a platform-synced row.",
        "parameters": [{ "name": "invoiceId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Ledger row updated" } }
      },
      "delete": {
        "tags": ["ERP"],
        "summary": "Delete manual payable",
        "description": "Deletes a manual payable; platform rows remain source-managed.",
        "parameters": [{ "name": "invoiceId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Manual payable deleted" } }
      }
    },
    "/api/erp/reconcile": {
      "post": {
        "tags": ["ERP"],
        "summary": "Backfill ERP ledger",
        "description": "Re-syncs all current buyer invoices into the local ledger and Google Sheet when connected.",
        "responses": { "200": { "description": "Reconciliation completed" } }
      }
    },
    "/api/erp/retry-failed": {
      "post": {
        "tags": ["ERP"],
        "summary": "Retry failed Google syncs",
        "description": "Retries rows that failed or are waiting for Google Sheets sync.",
        "responses": { "200": { "description": "Retry completed" } }
      }
    },
    "/api/erp/reconciliation": {
      "get": {
        "tags": ["ERP"],
        "summary": "Compare Clarity with Google Sheets",
        "description": "Finds missing, extra, and mismatched AP rows between Clarity and the connected sheet.",
        "responses": { "200": { "description": "Reconciliation issues returned" } }
      }
    },
    "/api/erp/sheet-template": {
      "post": {
        "tags": ["ERP"],
        "summary": "Create ERP Google Sheet",
        "description": "Creates Accounts Payable, Suppliers, and Sync Log tabs and backfills current invoices.",
        "responses": { "201": { "description": "Spreadsheet created" } }
      }
    },
    "/api/erp/suppliers": {
      "get": {
        "tags": ["ERP"],
        "summary": "Cross-reference suppliers",
        "description": "Compares platform suppliers against the buyer's supplier master sheet, including fuzzy matches and health bands.",
        "responses": { "200": { "description": "Supplier cross-reference returned" } }
      }
    },
    "/api/erp/admin/summary": {
      "get": {
        "tags": ["ERP"],
        "summary": "Admin ERP overview",
        "description": "Admin-only overview of ERP adoption, outstanding AP, overdue counts, and sync failures by buyer.",
        "responses": { "200": { "description": "Admin ERP summary returned" } }
      }
    }
  }
}
